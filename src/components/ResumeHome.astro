---
import type { Lang } from "../lib/resume";
import { localized, resumeData } from "../lib/resume";
import Hero from "./Hero.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = localized(lang);
const sections = [
  { id: "research", title: content.sections.research, projects: content.research },
  { id: "software", title: content.sections.software, projects: content.software },
  { id: "design", title: content.sections.design, projects: content.design },
];
---

<div class="page-shell">
  <SiteHeader lang={lang} />
  <Hero lang={lang} />

  <main>
    <nav class="section-nav" aria-label={lang === "zh" ? "頁面區塊" : "Page sections"}>
      <a href="#expertise">{content.nav.expertise}</a>
      <a href="#research">{content.nav.research}</a>
      <a href="#software">{content.nav.software}</a>
      <a href="#design">{content.nav.design}</a>
      <a href="#education">{content.nav.education}</a>
    </nav>

    <section class="content-band" id="expertise">
      <div class="section-heading">
        <h2>{content.sections.expertise}</h2>
      </div>
      <div class="expertise-grid">
        {content.expertise.map((item) => (
          <article class="expertise-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <div class="profile-grid">
        <div class="about-copy">
          <h3>{content.sections.about}</h3>
          {content.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <aside class="summary-panel" aria-labelledby="summary-title">
          <h3 id="summary-title">{content.sections.summary}</h3>
          {content.summary.map((paragraph) => <p>{paragraph}</p>)}
        </aside>
      </div>
    </section>

    {sections.map((section) => (
      <section class="content-band content-band--tight" id={section.id}>
        <div class="section-heading">
          <h2>{section.title}</h2>
        </div>
        <div class="project-stack">
          {section.projects.map((project) => (
            <article class="project-card">
              <div class="project-card__top">
                <div>
                  <h3>{project.title}</h3>
                  <p class="project-card__meta">{project.meta}</p>
                </div>
                <ul class="project-tags" aria-label={lang === "zh" ? "專案主題" : "Project themes"}>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <ul>
                {project.bullets.map((bullet) => (
                  <li><strong>{bullet.label}:</strong> {bullet.text}</li>
                ))}
              </ul>
              {"url" in project && typeof project.url === "string" && (
                <a class="project-source" href={project.url} target="_blank" rel="noopener noreferrer">
                  {section.id === "design" ? content.sections.docs : content.sections.source} ↗
                </a>
              )}
            </article>
          ))}
        </div>
        {section.id === "research" && (
          <div class="practice-note">
            <h3>{content.sections.practice}</h3>
            <ul>{content.practice.map((item) => <li>{item}</li>)}</ul>
          </div>
        )}
      </section>
    ))}

    <section class="content-band content-band--tight" id="education">
      <div class="section-heading">
        <h2>{content.sections.education}</h2>
      </div>
      {content.education.map((item) => (
        <article class="education-card">
          <h3>{item.school}</h3>
          <p>{item.degree} · {item.period}</p>
          {item.details.length > 0 && <ul>{item.details.map((detail) => <li>{detail}</li>)}</ul>}
        </article>
      ))}
    </section>
  </main>

  <footer class="footer">
    <span>{resumeData.contact.name[lang]}</span>
    <span> · </span>
    <a href={resumeData.contact.github.url}>{resumeData.contact.github.url}</a>
    <span> · </span>
    <a href={resumeData.contact.researchPath.url} target="_blank" rel="noreferrer">
      {resumeData.contact.researchPath.label[lang]}
    </a>
  </footer>
</div>
