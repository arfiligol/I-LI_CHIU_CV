---
import type { Lang } from "../lib/resume";
import { localized, resumeData } from "../lib/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = localized(lang);
const workSections = [
  { title: content.sections.research, projects: content.research },
  { title: content.sections.software, projects: content.software },
  { title: content.sections.design, projects: content.design },
];
---

<main class="print-shell">
  <article class="print-sheet">
    <header class="print-header">
      <div>
        <h1>{resumeData.contact.name[lang]}</h1>
        <p>{content.hero.role}</p>
      </div>
      <div class="print-contact">
        <div>{resumeData.contact.email}</div>
        <div>{resumeData.contact.github.url}</div>
        <div>{resumeData.contact.location[lang]}</div>
      </div>
    </header>

    <section class="print-section">
      <h2>{content.sections.summary}</h2>
      <p>{content.summary[0]}</p>
    </section>

    <section class="print-section">
      <h2>{content.sections.expertise}</h2>
      <ul class="print-expertise">
        {content.expertise.map((item) => <li><strong>{item.title}:</strong> {item.text}</li>)}
      </ul>
    </section>

    {workSections.map((section) => (
      <section class="print-section">
        <h2>{section.title}</h2>
        {section.projects.map((project) => (
          <article class="print-project">
            <h3>{project.title}</h3>
            <div class="print-project__meta">{project.meta}</div>
            <ul>
              <li><strong>{project.bullets[0].label}:</strong> {project.bullets[0].text}</li>
            </ul>
            {"url" in project && typeof project.url === "string" && (
              <a class="print-project__url" href={project.url}>{project.url}</a>
            )}
          </article>
        ))}
        {section.title === content.sections.research && <p>{content.practice.join(" ")}</p>}
      </section>
    ))}

    <section class="print-section">
      <h2>{content.sections.education}</h2>
      {content.education.map((item) => (
        <article class="print-education">
          <h3>{item.school}</h3>
          <p>{item.degree} · {item.period}</p>
        </article>
      ))}
    </section>
  </article>
</main>
